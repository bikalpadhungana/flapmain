/*
 * Copy this file to secrets.h (git-ignored) and fill it in to enable OTA updates
 * from the dashboard. Without secrets.h the walkie works normally, without OTA.
 *
 * The walkie has no permanent Wi-Fi: it joins this network only to check for an
 * update (when the dashboard deploys firmware with "Wake over LoRa", or on the
 * /ota serial or Bluetooth command), then switches Wi-Fi off.
 */
#ifndef ESP32_WALKIE_SECRETS_H
#define ESP32_WALKIE_SECRETS_H

#define OTA_WIFI_SSID     "your-wifi"
#define OTA_WIFI_PASSWORD "your-wifi-password"
#define OTA_SERVER        "http://main.esainnovation.com:5003"
// LoRa radios have no key of their own: use your gateway's FLAPMAIN_DEVICE_KEY.
#define OTA_DEVICE_KEY    "flap_dev_..."

// Switch OTA on only together with Tools -> Partition Scheme -> "Minimal SPIFFS
// (1.9MB APP with OTA)". With the default scheme the build fails: "Sketch too big".
// #define WALKIE_OTA 1

#endif
