/*
 * Copy this file to secrets.h (git-ignored) and fill it in to enable OTA updates
 * from the dashboard. Without secrets.h the station works normally, without OTA.
 *
 * The station has no permanent Wi-Fi: it joins this network only to check for an
 * update (1 minute after boot, every OTA_CHECK_HOURS, and right away when the
 * dashboard deploys firmware with "Wake over LoRa"), then switches Wi-Fi off.
 */
#ifndef ESP32_AWS_SECRETS_H
#define ESP32_AWS_SECRETS_H

#define OTA_WIFI_SSID     "your-wifi"
#define OTA_WIFI_PASSWORD "your-wifi-password"
#define OTA_SERVER        "http://main.esainnovation.com:5003"
// LoRa stations have no key of their own: use your gateway's FLAPMAIN_DEVICE_KEY.
#define OTA_DEVICE_KEY    "flap_dev_..."

#endif
