# ============================================================
# FlapMain Backend — Environment Configuration
# ============================================================

# Server port (Passenger may override this)
PORT=5003

# MongoDB connection string
# Use MONGO_URI or MONGODB_URI — both are supported
MONGODB_URI=mongodb://<db_user>:<db_password>@127.0.0.1:27017/flapmain

# JWT secret for user authentication (CHANGE THIS in production!)
JWT_SECRET=<generate-a-random-64+-char-secret>

# Server role: 'cloud' for live server, 'edge' for local gateway
NODE_ROLE=cloud

# ============================================================
# OPTIONAL — Only needed for edge/local gateway deployments
# ============================================================

# MQTT Broker URL (DISABLED on shared hosting — uncomment to re-enable)
# MQTT_BROKER_URL=mqtt://localhost:1883
# MQTT_USERNAME=flapmain_ingest
# MQTT_PASSWORD=flapmain_ingestion_pass

# Tap device forwarding URLs (only for edge mode)
# TAP_DEVICE_TARGET_URL=http://192.168.1.80:5001/api/device/tap
MAIN_FLAP_SERVER_URL=https://flap.esainnovation.com/api/device/tap

# ---- Security (see src/config/security.js) ----
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET is required; the server refuses to start without it.
# Device key checks on telemetry/gateway/camera endpoints: off | warn | enforce
# Roll out with `warn`, fix any devices logged as rejected, then switch to `enforce`.
DEVICE_AUTH_MODE=warn
# Socket.io handshake auth (dashboard JWT or partner API key): off | warn | enforce
SOCKET_AUTH_MODE=warn
# Comma-separated browser origins allowed for REST + Socket.io CORS
# CORS_ORIGINS=https://main.flap.com.np,https://main.esainnovation.com
# Allow webhooks/callbacks to LAN addresses (edge deployments only)
# ALLOW_PRIVATE_WEBHOOKS=false
# Minimum time between repeat firings of the same alert rule (ms)
# ALERT_COOLDOWN_MS=300000
